# Deployment parameters for this FreePBX site.
#
# Copy this file to `site.env`, fill in your real values, and keep `site.env`
# OUT of version control (it is gitignored). Throughout README.md and docs/ the
# real values are written as <PLACEHOLDER> tokens that map 1:1 to the keys below.

# Public IPv4 of the upstream SIP trunk peer (your provider). The site router
# forwards 5060/udp ONLY from this source address.
TRUNK_SRC_IP=<TRUNK_SRC_IP>

# Fully-qualified domain name the PBX is served under (TLS certificate subject).
PBX_FQDN=<PBX_FQDN>

# DNS zone that PBX_FQDN belongs to (used to scope the Cloudflare DNS-01 token).
DNS_ZONE=<DNS_ZONE>

# Internal IPv6 ULA address the host-networked PBX answers provisioning on.
PBX_ULA=<PBX_ULA>

# Internal IPv6 ULA /64 prefix handed to LAN phones.
PBX_ULA_PREFIX=<PBX_ULA_PREFIX>
